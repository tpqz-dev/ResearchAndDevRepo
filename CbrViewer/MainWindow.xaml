<Window x:Class="CbrViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CbrViewer"
        mc:Ignorable="d"
        Title="CBR Comic Book Reader" Height="600" Width="900">
    <DockPanel>
        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File">
                <MenuItem Header="Open CBR File..." Click="OpenFile_Click"/>
                <Separator/>
                <MenuItem Header="Exit" Click="Exit_Click"/>
            </MenuItem>
        </Menu>
        
        <!-- Navigation Controls -->
        <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="10">
            <Button Name="PreviousButton" Content="◄ Previous" Width="100" 
                    Click="Previous_Click" IsEnabled="False" DockPanel.Dock="Left"/>
            <TextBlock Name="PageInfoText" Text="No file loaded" 
                       VerticalAlignment="Center" HorizontalAlignment="Center" 
                       DockPanel.Dock="Left" Margin="20,0,0,0"/>
            <Button Name="NextButton" Content="Next ►" Width="100" 
                    Click="Next_Click" IsEnabled="False" DockPanel.Dock="Right"/>
        </DockPanel>
        
        <!-- Main Image Display Area -->
        <Border BorderBrush="Gray" BorderThickness="1" Margin="10">
            <ScrollViewer Name="ImageScrollViewer" 
                         HorizontalScrollBarVisibility="Auto" 
                         VerticalScrollBarVisibility="Auto"
                         MouseLeftButtonDown="ScrollViewer_MouseLeftButtonDown"
                         MouseMove="ScrollViewer_MouseMove"
                         MouseLeftButtonUp="ScrollViewer_MouseLeftButtonUp">
                <Image Name="ImageDisplay" 
                       Stretch="Uniform" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"/>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
