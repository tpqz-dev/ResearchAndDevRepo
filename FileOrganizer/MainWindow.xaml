<Window x:Class="FileOrganizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Organizer" Height="450" Width="800" ResizeMode="CanMinimize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="File Organizer" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- Directory Selection -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="Target Directory:" VerticalAlignment="Center" Width="120"/>
            <TextBox x:Name="DirectoryPathTextBox" Width="500" Margin="10,0,10,0" IsReadOnly="True"/>
            <Button x:Name="BrowseButton" Content="Browse..." Width="100" Click="BrowseButton_Click"/>
        </StackPanel>

        <!-- Monitoring Interval -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="Monitor Interval (min):" VerticalAlignment="Center" Width="150"/>
            <TextBox x:Name="IntervalTextBox" Width="100" Text="5" Margin="10,0,10,0"/>
            <TextBlock Text="minutes" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </StackPanel>

        <!-- Control Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,20">
            <Button x:Name="StartButton" Content="Start Organizing" Width="150" Height="35" Margin="0,0,10,0" Click="StartButton_Click" IsEnabled="False"/>
            <Button x:Name="StopButton" Content="Stop Monitoring" Width="150" Height="35" Margin="0,0,10,0" Click="StopButton_Click" IsEnabled="False"/>
            <Button x:Name="OrganizeNowButton" Content="Organize Now" Width="150" Height="35" Click="OrganizeNowButton_Click" IsEnabled="False"/>
        </StackPanel>

        <!-- Log/Status Area -->
        <GroupBox Grid.Row="4" Header="Status Log" Margin="0,0,0,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="LogTextBlock" TextWrapping="Wrap" Padding="5"/>
            </ScrollViewer>
        </GroupBox>

        <!-- Status Bar -->
        <StatusBar Grid.Row="5">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock" Text="Ready"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
